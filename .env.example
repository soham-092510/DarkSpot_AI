# ==============================================================================
# DarkSpot AI — Environment Configuration Template
# NOTE: DO NOT commit actual secrets to version control.
# Copy this file to .env for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=darkspot-hackathon-super-secret-key-change-in-production-2026

# Database Configuration
# Local SQLite fallback: sqlite:///./darkspot.db
# Production Supabase PostgreSQL: postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./darkspot.db

# AI Engine (Google Gemini)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Web Research (Tavily Search API)
# Obtain from https://app.tavily.com/
TAVILY_API_KEY=

# Supabase Auth & Storage (Optional for production auth integration)
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS & Frontend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://darkspot-ai.vercel.app"]

# Worker Settings
WORKER_POLL_INTERVAL_SECONDS=2
MAX_CONCURRENT_JOBS=2
